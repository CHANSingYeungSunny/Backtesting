# Copy this file to .env and fill in your own credentials.
# .env is git-ignored and must never be committed.
#
# The scripts read these via os.environ. Loading a .env file automatically
# requires the optional python-dotenv package:
#     pip install python-dotenv
# Without it, export the variables in your shell instead.

# ---- Seeking Alpha (seekingalpha.com) ------------------------------------
# Used by "Seeking Alpha/Seeking alpha backtesting.py" to pull the pick data.
SEEKINGALPHA_EMAIL=
SEEKINGALPHA_PASSWORD=

# ---- WhaleWisdom (whalewisdom.com) ---------------------------------------
# Used by both "Whale Wisdom/Backtesting I.py" and "Whale Wisdom/BacktestingII.py".
WHALEWISDOM_SHARED_ACCESS_KEY=
WHALEWISDOM_SECRET_ACCESS_KEY=